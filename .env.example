# Generated automatically by ./scripts/bootstrap.sh. Never commit the real .env.
NEO4J_PASSWORD=replace_with_random_database_password
KG_MCP_TOKEN=replace_with_random_api_token

NEURAL_MEMORY_PORT=8765
NEO4J_HTTP_PORT=8774
NEO4J_BOLT_PORT=8787
NEO4J_URI=bolt://127.0.0.1:8787

# Optional remote enrichment. Raw capture and graph storage do not need an LLM.
LLM_ENABLED=false
LLM_MODE=litellm
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
